<Window x:Class="ProductionApp.FieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner"
        Width="410" MinWidth="320" Height="Auto" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" Loaded="FieldWindow_Loaded">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" />
        <TextBlock x:Name="EditorHint" Style="{StaticResource HintText}" Margin="0,4,0,10" />
        <TextBox x:Name="ValueInput" AutomationProperties.LabeledBy="{Binding ElementName=HeadingText}" />
        <DatePicker x:Name="DateInput" Visibility="Collapsed" HorizontalAlignment="Left" Width="200"
                    SelectedDateFormat="Short" FirstDayOfWeek="Monday" DateValidationError="DateInput_Invalid"
                    SelectedDateChanged="DateInput_Changed"
                    AutomationProperties.LabeledBy="{Binding ElementName=HeadingText}">
            <DatePicker.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="MaxLength" Value="16" />
                </Style>
            </DatePicker.Resources>
        </DatePicker>
        <StackPanel x:Name="ActControls" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ActName" Style="{StaticResource HintText}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
            <WrapPanel>
                <Button x:Name="ChooseActButton" Content="Прикрепить акт" Click="ChooseAct_Click" Margin="0,0,6,4" />
                <Button x:Name="OpenActButton" Content="Открыть акт" Click="OpenAct_Click" Margin="0,0,6,4" />
                <Button x:Name="RemoveActButton" Content="Убрать акт" Click="RemoveAct_Click" Margin="0,0,0,4" />
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="#952B2B" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Применить" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
